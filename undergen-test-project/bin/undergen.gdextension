; undergen.gdextension
; Make sure the paths in library_paths match your SConstruct output

[configuration]

entry_symbol = "gdextension_entry_point"
compatibility_minimum = "4.7"

[libraries]

; Update these paths based on your exact platform and build target (debug/release)
linux.debug.x86_64 = "res://bin/libundergen.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libundergen.linux.template_release.x86_64.so"
linux.editor.x86_64 = "res://bin/libundergen.linux.editor.x86_64.so"
windows.debug.x86_64 = "res://bin/undergen.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/undergen.windows.template_release.x86_64.dll"