	"rules": [
		{
			"rule_name": "Entrance → Entry + Hub cascade",
			"lhs_symbol": "DungeonEntrance",
			"probability": 1.0,
			"entry_node_id": "entry",
			"exit_node_id": "hub",
			"rhs_nodes": [
				{
					"id": "entry",
					"symbol": "EntryRoom",
					"constraints": { "fixed_pos": [0, 0, -25] }
				},
				{
					"id": "hub",
					"symbol": "HubRoom",
					"constraints": { "fixed_pos": [0, 0, 0] }
				}
			],
			"rhs_edges": [
				{ "from": "entry", "to": "hub", "type": "corridor" }
			]
		},
		{
			"rule_name": "Hub → KeyVault + Corridor westward",
			"lhs_symbol": "HubRoom",
			"probability": 0.7,
			"entry_node_id": "hub",
			"exit_node_id": "corr",
			"actions": [
				{ "var": "keys", "delta": 1 }
			],
			"rhs_nodes": [
				{ "id": "hub",  "symbol": "HubRoom" },
				{ "id": "vault","symbol": "KeyVault" },
				{ "id": "corr", "symbol": "CorridorSegment" }
			],
			"rhs_edges": [
				{ "from": "hub",  "to": "vault", "type": "corridor" },
				{ "from": "vault","to": "corr",  "type": "secret" }
			]
		},
		{
			"rule_name": "Hub → Corridor + Encounter",
			"lhs_symbol": "HubRoom",
			"probability": 1.0,
			"entry_node_id": "hub",
			"exit_node_id": "corr",
			"actions": [
				{ "var": "danger_level", "delta": 1 }
			],
			"rhs_nodes": [
				{ "id": "hub",  "symbol": "HubRoom" },
				{ "id": "fight","symbol": "EncounterRoom" },
				{ "id": "corr", "symbol": "CorridorSegment" }
			],
			"rhs_edges": [
				{ "from": "hub",   "to": "fight", "type": "corridor" },
				{ "from": "fight", "to": "corr",  "type": "corridor" }
			]
		},
		{
			"rule_name": "Corridor → split to Treasure + Corridor",
			"lhs_symbol": "CorridorSegment",
			"probability": 0.6,
			"condition_var": "keys",
			"condition_op": ">=",
			"condition_val": 1,
			"entry_node_id": "corr_a",
			"exit_node_id": "corr_b",
			"actions": [
				{ "var": "keys", "delta": -1 }
			],
			"rhs_nodes": [
				{ "id": "corr_a",   "symbol": "CorridorSegment" },
				{ "id": "treasure", "symbol": "TreasureRoom" },
				{ "id": "corr_b",   "symbol": "CorridorSegment" }
			],
			"rhs_edges": [
				{ "from": "corr_a",   "to": "treasure", "type": "corridor" },
				{ "from": "treasure", "to": "corr_b",    "type": "corridor" }
			]
		},
		{
			"rule_name": "Corridor → Encounter + Corridor (danger >= 2)",
			"lhs_symbol": "CorridorSegment",
			"probability": 0.8,
			"condition_var": "danger_level",
			"condition_op": ">=",
			"condition_val": 2,
			"entry_node_id": "corr_a",
			"exit_node_id": "corr_b",
			"actions": [
				{ "var": "danger_level", "delta": 1 }
			],
			"rhs_nodes": [
				{ "id": "corr_a", "symbol": "CorridorSegment" },
				{ "id": "fight",  "symbol": "EncounterRoom" },
				{ "id": "corr_b", "symbol": "CorridorSegment" }
			],
			"rhs_edges": [
				{ "from": "corr_a", "to": "fight",  "type": "corridor" },
				{ "from": "fight",  "to": "corr_b", "type": "corridor" }
			]
		},
		{
			"rule_name": "Corridor → BossArena (danger >= 3, terminal)",
			"lhs_symbol": "CorridorSegment",
			"probability": 0.5,
			"condition_var": "danger_level",
			"condition_op": ">=",
			"condition_val": 3,
			"rhs_nodes": [
				{ "id": "boss", "symbol": "BossArena" }
			],
			"rhs_edges": []
		},
		{
			"rule_name": "Corridor → DeadEnd terminal (fallback)",
			"lhs_symbol": "CorridorSegment",
			"probability": 1.0,
			"rhs_nodes": [
				{ "id": "end", "symbol": "DeadEnd" }
			],
			"rhs_edges": []
		}
	]
